        <condition/>
        <description>Rejects T&amp;M Rate Card records if proposal contract_type is not T&amp;M</description>
        <execute_function>false</execute_function>
        <filter_condition/>
        <is_rest>false</is_rest>
        <message/>
        <name>Validate T&amp;M Contract Type Match</name>
        <order>100</order>
