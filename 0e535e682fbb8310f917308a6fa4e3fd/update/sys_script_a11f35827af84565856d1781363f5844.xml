        <script><![CDATA[(function executeRule(current, previous) {
    var proposalId = current.getValue('proposal');
    if (!proposalId) return;
    
    var proposalGr = new GlideRecord('x_942105_costima_0_proposal');
    if (proposalGr.get(proposalId)) {
        var contractType = proposalGr.getValue('contract_type');
        if (contractType !== 'tm') {
            gs.addErrorMessage(
                'Cannot insert T&M Rate Card record. Proposal "' + 
                proposalGr.getValue('proposal_name') + 
                '" has contract type "' + (contractType || 'not set').toUpperCase() + 
                '", but this table requires contract type "T&M".'
            );
            current.setAbortAction(true);
        }
    }
})(current, previous);
]]></script>
